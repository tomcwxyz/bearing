ANTHROPIC_API_KEY=sk-ant-xxx
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
OPENROUTER_API_KEY=sk-or-xxx
# Optional provider-primary catalogue verification. Bearing skips providers
# whose key is absent and falls back to OpenRouter where a mapping exists.
OPENAI_API_KEY=sk-xxx
MISTRAL_API_KEY=xxx
GEMINI_API_KEY=xxx
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Bearing <hello@yourdomain.com>
AUTH_SECRET=generate-a-random-64-char-string
# Auth.js's own canonical base URL (its "AUTH_URL" convention) — set this to
# the production domain in Vercel; Auth.js can often infer it from
# VERCEL_URL, but setting it explicitly avoids preview-deployment redirect
# edge cases. Only add AUTH_TRUST_HOST=true if sign-in redirects misbehave.
AUTH_URL=http://localhost:3000
# Set in production. Falls back to VERCEL_URL (auto-set by Vercel), then localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Plausible Analytics: your site domain as registered in Plausible. Leave unset to disable tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=findbearing.org
